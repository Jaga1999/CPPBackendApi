# =================================================================
# CrowApi Environment Configuration Template (.env.example)
# Copy this file to .env or .env.test and adjust values accordingly.
# =================================================================

# Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
LOG_LEVEL=info
SERVER_THREADS=16

# PostgreSQL 18.6 Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crowapi_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_MAX_POOL_SIZE=20
DB_CONNECT_TIMEOUT=5

# JWT & Cryptographic Security
JWT_KEY_ID=key-2026-prod-01
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_DAYS=30

# Authentication & Rate Limiting Controls
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Google OAuth2 Settings
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback